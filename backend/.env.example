# Sarvam AI Configuration (Speech-to-Text & Contextual LLM Analysis)
SARVAM_API_KEY="YOUR_SARVAM_API_KEY_HERE"
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_STT_MODEL="saaras:v3"
SARVAM_LLM_MODEL="sarvam-105b"
SARVAM_TIMEOUT_SECONDS="5.0"

# Audio Upload & Validation Limits
MAX_AUDIO_FILE_SIZE_MB="10"
ALLOWED_AUDIO_EXTENSIONS="wav,mp3,ogg,m4a,flac,webm"

# Risk Scoring & Calibration Configuration
RULE_SCORE_WEIGHT="0.45"
CONTEXTUAL_SCORE_WEIGHT="0.55"
DEEPFAKE_SCORE_WEIGHT="0.15"
LOW_RISK_THRESHOLD="30.0"
MEDIUM_RISK_THRESHOLD="60.0"
HIGH_RISK_THRESHOLD="80.0"
CRITICAL_RISK_THRESHOLD="80.0"
MIN_TRANSCRIPT_CONFIDENCE="0.40"

# Calibrated Probability (p_scam) Settings
# Keep CALIBRATED_PROBABILITY_ENABLED="false" until a Platt/Isotonic calibration model is validated.
CALIBRATED_PROBABILITY_ENABLED="false"
CALIBRATION_SLOPE="4.2"
CALIBRATION_INTERCEPT="-2.1"

# Conversation State & Privacy Retention Policy
CALL_STATE_RETENTION_SECONDS="3600"
MAX_SEGMENTS_PER_CALL="200"
LOG_SENSITIVE_TRANSCRIPTS="false"
ENABLE_CROSS_CALL_KEYWORD_SYNC="true"
ENABLE_DEEPFAKE_DETECTION="false"

# Optional Telegram Bot Protective Alerts
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"
TELEGRAM_ALERTS_ENABLED="true"
TELEGRAM_ALERT_THRESHOLD="HIGH"
TELEGRAM_AUTHORIZED_USERS=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_TIMEOUT_SECONDS="4.0"

# Telegram VoIP Call Bridge (ashboi005/onfloor WS Ingest)
BRIDGE_SECRET=""

# RAG Semantic Retrieval & Contextual Scam Detection Engine
RAG_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RAG_EMBEDDING_DIM="384"
RAG_BATCH_SIZE="64"
RAG_TOP_K="5"
RAG_SIM_THRESHOLD="0.38"
RAG_STRONG_SIM_THRESHOLD="0.68"
RAG_AMBIGUITY_MARGIN="0.10"
RAG_VECTOR_STORE_DIR="vector_store"
RAG_CHROMA_COLLECTION="scam_detection_corpus"
RAG_DATA_DIR="data"

# LiveKit Cloud Real-Time Internet Calling Configuration
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_TOKEN_TTL_SECONDS="3600"
LIVEKIT_AI_DETECTION_ENABLED="true"
