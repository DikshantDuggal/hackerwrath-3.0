# Copy to .env and fill in. Never commit .env.

# Signing key for app session tokens: 32+ random characters.
APP_JWT_SECRET=change-me-to-32-or-more-random-characters

# Demo accounts as username:password pairs, comma separated.
DEMO_USERS=demo-user:change-me

# 1 enables the demo call driver (POST /api/demo/calls). Off in any real deployment.
DEMO_MODE=1

# Public HTTPS base URL of this backend (Twilio webhooks and media streams need it).
PUBLIC_BASE_URL=https://your-backend.example.com

# Twilio (voice token for the app). Leave empty to run in demo mode only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PUSH_CREDENTIAL_SID=
TWILIO_SERVICE_NUMBER=

# Sarvam (speech recognition and assessment), used by the call engine.
SARVAM_API_KEY=
STT_MODEL=saaras:v3-realtime
STT_LANGUAGE=auto
DETECTOR_MODEL=sarvam-105b
DETECTOR_PROMPT=detector_v1

# Detection plug-ins (docs/plugins.md). "none" never warns; "example" is for testing the
# sockets only, never the demo; "http" calls DETECTOR_URL. Add your own by name.
PHRASE_ENGINE=none
DETECTOR_PROVIDER=none
DETECTOR_TIMEOUT=3.0
DETECTOR_RATE_PER_MINUTE=40
# For DETECTOR_PROVIDER=http: an https URL (http only for localhost) and a shared secret.
DETECTOR_URL=
DETECTOR_TOKEN=
# Extra modules that register plug-ins, comma separated (for example friends.suraksha).
DETECTION_PLUGINS=

# Never 1 at the demo: logs transcripts for team test calls only.
DEBUG_TRANSCRIPTS=0
